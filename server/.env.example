# ==================================================
# HENRIQUE BARBER — Servidor (copy para .env)
# ==================================================

# Porta do backend.
# ATENÇÃO: a porta 3000 desta máquina é usada por OUTRO projeto (Evolution Manager/Docker).
# HENRIQUE BARBER usa a porta dedicada 3333 (escolhida por estar livre).
PORT=3333

# Banco de producao (Neon PostgreSQL) — preenchido apenas no deploy.
# Nunca commitar o valor real.
DATABASE_URL=

# Segredo do JWT — troque por um valor forte em producao
JWT_SECRET=

# Origem permitida no CORS (frontend)
CORS_ORIGIN=http://localhost:5174

# URL publica base (Link de Agendamento / QR Code)
PUBLIC_BASE_URL=http://localhost:5174

# Ambiente: development | production
NODE_ENV=development

# Expiração do token
TOKEN_EXPIRES=12h

# Primeiro administrador (criado no primeiro start / seed)
ADMIN_NAME=Henrique
ADMIN_EMAIL=admin@henriquebarber.com.br
ADMIN_PASSWORD=